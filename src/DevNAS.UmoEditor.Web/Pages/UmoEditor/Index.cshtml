@page
@using Microsoft.Extensions.Localization
@using DevNAS.UmoEditor.Localization
@using DevNAS.UmoEditor.Web.Components.UmoEditor
@using DevNAS.UmoEditor.Web.Pages.UmoEditor
@model DevNAS.UmoEditor.Web.Pages.UmoEditor.IndexModel
@inject IStringLocalizer<UmoEditorResource> L

@{
}

@* The widget does NOT load its own assets - the embedding page does, exactly like this. See
   Components/UmoEditor/Default.cshtml for why self-emission was removed. On a page that only
   DISPLAYS content and never invokes UmoEditorViewComponent, use
   UmoEditorViewerScriptContributor instead. Never register both: they are ~3 MB each and
   overlap almost entirely. *@
<abp-style-bundle>
    <abp-style type="typeof(UmoEditorStyleContributor)" />
</abp-style-bundle>
<abp-script-bundle>
    <abp-script type="typeof(UmoEditorScriptContributor)" />
</abp-script-bundle>

<h1>@L["SamplePageMessage"]</h1>

@await Component.InvokeAsync(typeof(UmoEditorViewComponent), new UmoEditorViewModel
{
    Id = "umo-editor-demo",
    FormFieldName = "UmoEditorDemoContent",
})

<div class="mt-3">
    <button type="button" class="btn btn-outline-secondary btn-sm" id="umo-editor-demo-log">
        Log getJSON() to console
    </button>
</div>

<script>
    document.getElementById("umo-editor-demo-log").addEventListener("click", function () {
        var instance = window.DevNasUmoEditor.get("#umo-editor-demo");
        console.log(instance ? instance.getJSON() : "widget not ready yet");
    });
</script>
